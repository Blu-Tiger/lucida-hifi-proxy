# Copy to .env and adjust. docker compose reads this file automatically.

# The address your SoulSync instance uses to reach this proxy. It is embedded in
# the manifest URLs the proxy hands back, so it must be reachable FROM SoulSync:
#   - SoulSync on another machine  -> the LAN IP of this host, e.g. http://192.168.1.3:8002
#   - SoulSync in Docker on this host -> http://host.docker.internal:8002
PROXY_BASE_URL=http://host.docker.internal:8002

# lucida.to service used for search. qobuz works today; amazon fails every
# search with a backend error upstream and spotify reports itself disabled.
LUCIDA_SERVICE=qobuz

# Country lucida.to reports results for.
LUCIDA_COUNTRY=US
